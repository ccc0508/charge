<!--pages/add/add.wxml-->
<wxs src="../../utils/icons.wxs" module="icons" />

<!-- 收入/支出 Tab -->
<view class="tabs-wrap">
  <view class="tabs">
    <view
      class="tab {{type === 'expense' ? 'tab-active' : ''}}"
      data-type="expense"
      bindtap="onTabChange"
    >
      支出
    </view>
    <view
      class="tab {{type === 'income' ? 'tab-active' : ''}}"
      data-type="income"
      bindtap="onTabChange"
    >
      收入
    </view>
  </view>
</view>

<!-- 金额显示 -->
<view class="amount-display">
  <text class="amount-value">{{displayAmount}}</text>
</view>

<!-- 分类选择 -->
<view class="category-grid">
  <view
    wx:for="{{categories}}"
    wx:key="key"
    class="category-item"
    data-key="{{item.key}}"
    bindtap="onCategoryTap"
  >
    <view class="cat-icon-wrap {{selectedCategory === item.key ? 'cat-selected' : ''}}" style="background: {{icons.getColor(item.key)}};">
      <text class="cat-icon">{{icons.getIcon(item.key)}}</text>
    </view>
    <text class="cat-label {{selectedCategory === item.key ? 'cat-label-active' : ''}}">{{item.label}}</text>
  </view>
</view>

<!-- 备注快捷输入 -->
<view class="note-bar">
  <input
    class="note-input"
    placeholder="添加备注..."
    placeholder-class="note-placeholder"
    value="{{note}}"
    bindinput="onNoteInput"
    maxlength="30"
  />
  <picker mode="date" value="{{date}}" bindchange="onDateChange">
    <view class="date-btn">📅 {{dateLabel}}</view>
  </picker>
</view>

<!-- 自定义数字键盘 -->
<view class="keypad">
  <view class="keypad-grid">
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="7" bindtap="onKeyTap">7</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="8" bindtap="onKeyTap">8</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="9" bindtap="onKeyTap">9</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="4" bindtap="onKeyTap">4</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="5" bindtap="onKeyTap">5</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="6" bindtap="onKeyTap">6</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="1" bindtap="onKeyTap">1</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="2" bindtap="onKeyTap">2</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="3" bindtap="onKeyTap">3</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="." bindtap="onKeyTap">.</view>
    <view class="key" hover-class="key-hover" hover-stay-time="0" data-val="0" bindtap="onKeyTap">0</view>
    <view class="key key-del" hover-class="key-del-hover" hover-stay-time="0" bindtap="onKeyDelete">
      <text class="del-icon">⌫</text>
    </view>
  </view>
  <view class="keypad-right">
    <view class="key-done" hover-class="key-done-hover" hover-stay-time="0" bindtap="onSave">
      <text class="done-text">完成</text>
    </view>
  </view>
</view>
