/**
 * 图标映射 WXS 模块
 * 在渲染层直接生成 emoji，避免通过 setData 传输 emoji 字符
 */

var ICONS = {
  food:           '🍔',
  transport:      '🚌',
  shopping:       '🛒',
  entertainment:  '🎮',
  housing:        '🏠',
  medical:        '💊',
  education:      '📚',
  other_expense:  '📦',
  salary:         '💰',
  bonus:          '🎁',
  investment:     '📈',
  parttime:       '💼',
  other_income:   '📦'
}

var COLORS = {
  food:           '#e74c3c',
  transport:      '#3498db',
  shopping:       '#e67e22',
  entertainment:  '#9b59b6',
  housing:        '#1abc9c',
  medical:        '#e74c3c',
  education:      '#3498db',
  other_expense:  '#95a5a6',
  salary:         '#2ecc71',
  bonus:          '#f1c40f',
  investment:     '#27ae60',
  parttime:       '#16a085',
  other_income:   '#95a5a6'
}

module.exports = {
  getIcon: function(key) {
    return ICONS[key] || '📦'
  },
  getColor: function(key) {
    return COLORS[key] || '#95a5a6'
  }
}
