/**
 * 图标映射 WXS 模块
 * 返回本地 SVG 图标路径和对应颜色
 */

var ICON_PATH = {
  food:           '/images/icons/food.svg',
  transport:      '/images/icons/transport.svg',
  shopping:       '/images/icons/shopping.svg',
  entertainment:  '/images/icons/entertainment.svg',
  housing:        '/images/icons/housing.svg',
  medical:        '/images/icons/medical.svg',
  education:      '/images/icons/education.svg',
  other_expense:  '/images/icons/other.svg',
  salary:         '/images/icons/salary.svg',
  bonus:          '/images/icons/bonus.svg',
  investment:     '/images/icons/investment.svg',
  parttime:       '/images/icons/parttime.svg',
  other_income:   '/images/icons/other.svg'
}

var COLORS = {
  food:           '#e74c3c',
  transport:      '#3498db',
  shopping:       '#e67e22',
  entertainment:  '#9b59b6',
  housing:        '#1abc9c',
  medical:        '#e74c3c',
  education:      '#3498db',
  other_expense:  '#95a5a6',
  salary:         '#2ecc71',
  bonus:          '#f1c40f',
  investment:     '#27ae60',
  parttime:       '#16a085',
  other_income:   '#95a5a6'
}

module.exports = {
  getIcon: function(key) {
    return ICON_PATH[key] || '/images/icons/other.svg'
  },
  getColor: function(key) {
    return COLORS[key] || '#95a5a6'
  }
}
